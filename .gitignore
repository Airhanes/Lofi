# secrets — never commit
.env
.env.*
secrets/*
!secrets/README.md
client_secret*.json
token*.json

# python
__pycache__/
*.egg-info/
.pytest_cache/
.venv/
build/
dist/

# media is large and regenerable: keep only the text records in git
episodes/*/tracks/*
!episodes/*/tracks/.gitkeep
episodes/*/art/*
!episodes/*/art/.gitkeep
!episodes/*/art/prompt.txt
!episodes/*/art/REVIEW.md
!episodes/*/art/manifest.json
episodes/*/out/*
!episodes/*/out/qa.md
!episodes/*/out/description.txt
!episodes/*/out/timestamps.json
!episodes/*/out/metadata.json
stream/playlist.txt
